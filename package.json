{
  "name": "foodtruck",
  "version": "1.0.0",
  "description": "API REST du module I321 - Programmer des systèmes distribués (CPNV)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test --test-concurrency=1 --test-timeout=60000 tests/starter.test.js",
    "test:acceptance": "node --test --test-concurrency=1 --test-timeout=60000 tests/*.acceptance.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CPNV-KMI-I321/I321-RubentenCate.git"
  },
  "bugs": {
    "url": "https://github.com/CPNV-KMI-I321/I321-RubentenCate/issues"
  },
  "homepage": "https://github.com/CPNV-KMI-I321/I321-RubentenCate#readme",
  "dependencies": {
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1"
  }
}
